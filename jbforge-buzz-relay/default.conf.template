# nginx gateway for the Buzz Relay Umbrel app.
#
# Two listeners:
#   :80   — the community relay, reached through Umbrel's app_proxy on the app
#           port. Unauthenticated by design: the Buzz desktop app must reach the
#           WebSocket and REST surface directly.
#   :8081 — the admin dashboard, published on its own host port and gated by
#           HTTP Basic auth against this app's Umbrel-generated APP_PASSWORD.
#
# The nginx image's entrypoint envsubst's ${BUZZ_*} at container start; the
# NGINX_ENVSUBST_FILTER in docker-compose.yml keeps nginx's own runtime $vars
# untouched. The file name is load-bearing: it renders to
# /etc/nginx/conf.d/default.conf, replacing the image's own default server —
# any other name would leave that one bound to :80 ahead of this one.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The relay's admin surface authorizes on the Host header and, when the browser
# sends one, on Origin. We rewrite both to the fixed internal admin authority so
# the dashboard works from any name the box answers to — umbrel.local, the LAN
# IP, a Tailscale MagicDNS name — instead of being pinned to one of them the way
# the community host is. Empty value = header not sent, so a same-origin fetch
# (which omits Origin) stays without one rather than gaining a forged header.
map $http_origin $buzz_admin_origin {
    default "http://${BUZZ_ADMIN_HOST}";
    ''      "";
}

# Community relay. The canonical host passes through to the relay with
# WebSocket upgrade support; any other Host (e.g. the Umbrel dashboard tile's
# LAN URL) 302s to the canonical public URL, because the relay binds a community
# to exactly one host and answers 404 on the others.
server {
    listen 80;
    server_name _;

    if ($host != "${BUZZ_CANONICAL_HOST}") {
        return 302 ${BUZZ_PUBLIC_URL}$request_uri;
    }

    location / {
        proxy_pass http://${BUZZ_RELAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        client_max_body_size 512m;
    }
}

# Admin dashboard.
server {
    listen 8081;
    server_name _;

    auth_basic "Buzz Relay admin";
    auth_basic_user_file /etc/nginx/admin.htpasswd;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Relay stats page. Static, served from this container — the upstream relay
    # has no stats API, so the page reads the numbers the relay already exports
    # on its health and metrics ports (proxied below).
    location = / {
        root /usr/share/nginx/buzz-admin;
        try_files /index.html =404;
    }

    # Service name, relay version and process uptime (relay health port).
    location = /_status {
        proxy_pass http://${BUZZ_RELAY_HEALTH_UPSTREAM}/_status;
        proxy_set_header Host $host;
    }

    # Prometheus exposition. The metrics exporter answers on every path, so the
    # trailing slash maps /metrics onto its root.
    location = /metrics {
        proxy_pass http://${BUZZ_RELAY_METRICS_UPSTREAM}/;
        proxy_set_header Host $host;
    }

    # NIP-11 document for the canonical community — relay identity, supported
    # NIPs, limits. Requested with the community's own Host, not the admin one:
    # the relay short-circuits the admin authority before NIP-11 is served.
    location = /_relay_info {
        proxy_pass http://${BUZZ_RELAY_UPSTREAM}/;
        proxy_set_header Host ${BUZZ_CANONICAL_HOST};
        proxy_set_header Accept "application/nostr+json";
    }

    # Full backup: pg_dump of every community + media + git + the signing key,
    # streamed as one tar.gz by the backup sidecar. Buffering off so the browser
    # starts receiving as the archive is sent rather than after nginx has spooled
    # the whole thing to disk; the timeouts cover a slow dump on a large relay.
    location = /backup {
        proxy_pass http://${BUZZ_BACKUP_UPSTREAM}/cgi-bin/backup;
        proxy_buffering off;
        proxy_read_timeout 60m;
        proxy_send_timeout 60m;
    }

    # Everything else is the relay's own admin bundle: the moderation SPA at
    # /reports and /feedback, its /assets, and /api/admin/v1.
    location / {
        proxy_pass http://${BUZZ_RELAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${BUZZ_ADMIN_HOST};
        proxy_set_header Origin $buzz_admin_origin;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 1m;
    }
}
